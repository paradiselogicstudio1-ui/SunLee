# Copy this file to .env and fill in your mail server's details.

# SMTP server connection
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
# Set to "true" for port 465 (implicit TLS), "false" for 587/25 (STARTTLS)
SMTP_SECURE=false

# SMTP credentials (leave both blank if your server allows unauthenticated relay)
SMTP_USER=contact@yourdomain.com
SMTP_PASS=your-smtp-password

# Inbox that should receive the contact form submissions.
# Note: the "From" address on these emails is set to the submitter's own
# email/name, so the recipient sees who filled out the form directly. Some
# mail providers may flag this as spam if SPF/DKIM doesn't allow sending as
# arbitrary external domains — test delivery on your server.
MAIL_TO=sales@yourdomain.com

# Port the Node server listens on
PORT=3001
